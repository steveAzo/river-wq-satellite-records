# ---------------------------------------------------------------------------------------------
# Paper 3 repository. Grouped by WHY a file must not be pushed.
# NOTE: .gitignore only affects UNTRACKED files. A file committed by mistake must be removed from
# the index with `git rm --cached <path>` (this keeps it on disk).
# ---------------------------------------------------------------------------------------------

# 1. Private data: the Weija deployment records belong to the deployment team (the Prof's lab) and
#    must never be published. Results derived from them (counts, scores) are fine.
data/clean/weija_cycles.csv
results/confirm/lowcost_input/Weija.csv

# 2. Copyrighted literature (publisher PDFs and text extracted from them). Our own notes stay.
papers/pdf/
papers/txt/
papers/txt_flow/
papers/standards/*.pdf
papers/standards/*.txt
papers/*.tmp

# 3. Internal notes for the authors (not for a public repository)
draft/COVER_NOTE.md

# 4. Too large for GitHub (126 MB; limit 100 MB): scoping experiment E2 output, superseded and
#    regenerated by src/scoping/e2_upload_order.py
results/scoping/e2_upload_order_*.csv

# 5. Generated files: rebuilt by draft/build.sh or by the analysis scripts
draft/deliverables/
draft/build/
draft/main.pdf
draft/*.log
draft/word_main.tex
draft/word_main.tex.json
draft/word_raw.docx
draft/bib/cache/
draft/figs/*.aux
draft/figs/*.log
results/sens/parts_*/
*.aux
*.bbl
*.blg
*.out
*.spl
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# 6. Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# 7. OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
~$*
